# --- RPC endpoints (public, comma-separated, tried in order with failover) ---
# Canonical Robinhood Chain mainnet RPC
BONNET_RPC_ENDPOINTS=https://rpc.mainnet.chain.robinhood.com,https://mainnet.rpc.robinhood.com,https://rhc-mainnet.rpc.openledger.xyz?app=bonnet

# --- Discovery sources ---
# DexScreener public API (free tier, 300 req/min)
BONNET_DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest

# --- On-chain factory scanner (JSON array) ---
# Leave empty to use defaults (canonical Uniswap v2/v3 on Ethereum mainnet).
# For Robinhood Chain DEXes, run `bonnet detect-factories <known_pool>` and
# paste the output here.
# Example shape:
# BONNET_FACTORIES=[{"address":"0x...","chain":"robinhood","kind":"v3","event_signature":"0x...","event_name":"PoolCreated","pool_topic_index":3}]
BONNET_FACTORIES=

# --- Scoring thresholds ---
BONNET_SCORE_ALERT_THRESHOLD=0.65
BONNET_VOLUME_MIN_USD_24H=5000
BONNET_AGE_MIN_HOURS=2

# --- Rug heuristics ---
BONNET_RUG_MAX_TOP10_HOLDER_PCT=40.0
BONNET_RUG_MIN_LP_LOCK_DAYS=7
BONNET_RUG_MIN_CONTRACT_AGE_HOURS=24

# --- Telegram alerts (optional) ---
# Create a separate bot for Bonnet via @BotFather. DO NOT reuse the hermes
# trading bot token.
BONNET_TELEGRAM_BOT_TOKEN=
BONNET_TELEGRAM_CHAT_ID=

# --- Storage ---
BONNET_DB_PATH=./state/bonnet.db

# --- Logging ---
BONNET_LOG_LEVEL=INFO