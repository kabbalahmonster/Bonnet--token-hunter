[Unit]
Description=Bonnet Telegram bot — /label, /show, /ping listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fuzzbox/projects/coin-analyzer
Environment=PATH=/home/fuzzbox/projects/coin-analyzer/.venv/bin
EnvironmentFile=/home/fuzzbox/projects/coin-analyzer/.env
ExecStart=/home/fuzzbox/projects/coin-analyzer/.venv/bin/bonnet telegram-bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target